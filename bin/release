#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# Usage: bin/release <version>
#   Example: bin/release 0.5.0
#
# Bumps the version, opens a PR from develop → main via tea, merges it,
# tags the release on main, and syncs develop back. Gem publish is manual
# (instructions printed at the end).
# ---------------------------------------------------------------------------

VERSION="${1:-}"

if [[ -z "$VERSION" ]]; then
  echo "Usage: bin/release <version>" >&2
  echo "  Example: bin/release 0.5.0" >&2
  exit 1
fi

if ! [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
  echo "Error: version must be X.Y.Z (got: ${VERSION})" >&2
  exit 1
fi

# Must be on develop
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$BRANCH" != "develop" ]]; then
  echo "Error: must be on develop branch (currently on '${BRANCH}')" >&2
  exit 1
fi

# Working tree must be clean
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Error: working tree is not clean — commit or stash changes first" >&2
  exit 1
fi

VERSION_FILE="lib/rest_requestor/version.rb"
CURRENT_VERSION=$(ruby -e "require_relative '${VERSION_FILE}'; puts RestRequestor::VERSION")

if [[ "$VERSION" == "$CURRENT_VERSION" ]]; then
  echo "Error: ${VERSION} is already the current version" >&2
  exit 1
fi

TAG="v${VERSION}"

echo "==> Releasing ${VERSION} (was ${CURRENT_VERSION})"

# Bump version file
sed -i '' "s/VERSION = \"${CURRENT_VERSION}\"/VERSION = \"${VERSION}\"/" "$VERSION_FILE"

# Run tests
echo "==> Running tests"
ruby -Ilib test/test_rest_requestor.rb

# Commit and push develop
echo "==> Committing version bump"
git add "$VERSION_FILE"
git commit -m "Bumps version to ${VERSION}"

echo "==> Pushing develop"
git push origin develop

# Open PR
echo "==> Opening PR develop → main"
PR_URL=$(tea pr create \
  --base main \
  --head develop \
  --title "Release ${VERSION}" \
  --description "Bumps version to ${VERSION}")

PR_NUMBER=$(basename "$PR_URL")
echo "    PR #${PR_NUMBER}: ${PR_URL}"

# Merge PR
echo "==> Merging PR #${PR_NUMBER}"
tea pr merge "$PR_NUMBER" \
  --style merge \
  --title "Release ${VERSION}" \
  --message "Merge develop into main for release ${VERSION}"

# Pull main and tag
echo "==> Tagging ${TAG} on main"
git checkout main
git pull origin main
git tag -a "$TAG" -m "Release ${VERSION}"
git push origin "$TAG"

# Sync develop with main
echo "==> Syncing develop"
git checkout develop
git merge main
git push origin develop

echo ""
echo "==> Done. ${TAG} is live on main."
echo ""
echo "    To publish to RubyGems:"
echo "      gem build rest_requestor.gemspec"
echo "      gem push rest_requestor-${VERSION}.gem"
echo "      rm rest_requestor-${VERSION}.gem"
