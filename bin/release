#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# Usage: bin/release <version>
#   Example: bin/release 0.6.0
#
# Skeleton flow: bumps the version on develop, runs the tests, fast-forwards
# main to develop, tags the release on main, and pushes main + tag. develop is
# never pushed. Gem publish is manual (instructions printed at the end).
# ---------------------------------------------------------------------------

VERSION="${1:-}"

if [[ -z "$VERSION" ]]; then
  echo "Usage: bin/release <version>" >&2
  echo "  Example: bin/release 0.6.0" >&2
  exit 1
fi

if ! [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Error: version must be X.Y.Z (got: ${VERSION})" >&2
  exit 1
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$BRANCH" != "develop" ]]; then
  echo "Error: must be on develop branch (currently on '${BRANCH}')" >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Error: working tree is not clean — commit or stash changes first" >&2
  exit 1
fi

TAG="v${VERSION}"
if git rev-parse -q --verify "refs/tags/${TAG}" >/dev/null; then
  echo "Error: tag ${TAG} already exists" >&2
  exit 1
fi

# main is only ever fast-forwarded, so origin/main must already be in develop
git fetch --quiet origin
if ! git merge-base --is-ancestor origin/main develop; then
  echo "Error: origin/main has commits not in develop — reconcile first" >&2
  exit 1
fi

VERSION_FILE="lib/rest_requestor/version.rb"
CURRENT_VERSION=$(ruby -e "require_relative '${VERSION_FILE}'; puts RestRequestor::VERSION")

if [[ "$VERSION" == "$CURRENT_VERSION" ]]; then
  echo "Error: ${VERSION} is already the current version" >&2
  exit 1
fi

echo "==> Releasing ${VERSION} (was ${CURRENT_VERSION})"

sed -i '' "s/VERSION = \"${CURRENT_VERSION}\"/VERSION = \"${VERSION}\"/" "$VERSION_FILE"

echo "==> Running tests"
if ! ruby -Ilib test/test_rest_requestor.rb; then
  git checkout -- "$VERSION_FILE"
  echo "Error: tests failed — version bump reverted" >&2
  exit 1
fi

echo "==> Committing version bump"
git add "$VERSION_FILE"
git commit -m "Bumps Version To ${VERSION}"

echo "==> Fast-forwarding main"
git checkout main
git merge --ff-only develop

echo "==> Tagging ${TAG} on main"
git tag -a "$TAG" -m "Release ${VERSION}"

echo "==> Pushing main and ${TAG}"
git push origin main "$TAG"

git checkout develop

echo ""
echo "==> Done. ${TAG} is live on main."
echo ""
echo "    To publish to RubyGems:"
echo "      gem build rest_requestor.gemspec"
echo "      gem push rest_requestor-${VERSION}.gem"
echo "      /bin/rm rest_requestor-${VERSION}.gem"
